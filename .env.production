# ==========================================================
# Climatify — Production Environment Variables
# Used by Vite during production builds (e.g. Vercel deployment)
# ==========================================================

# Note:
# - When VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are configured in Vercel
#   Environment Variables, Supabase activates automatically and mock mode is
#   disabled (`USE_MOCK_API = false`).
# - When Supabase keys are NOT configured (e.g. standalone preview/demo deploy),
#   the app safely runs in offline-capable demo mode without local network calls.
VITE_USE_MOCK_API=true
